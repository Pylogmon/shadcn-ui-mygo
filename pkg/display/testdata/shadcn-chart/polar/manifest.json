  "oracle": "Actual verified complete CJS geometry modules, inert rendering/state dependencies; flat property lookup and React element capture only; no Go/product/reference geometry implementation.",
  "sourceSemantics": {
    "pie": "item inspection includes current fill layers and painted strokes",
    "radar": "angular axis inspection; idle dots follow current polygon while active dots use targets",
    "radial": "radial axis inspection includes unfilled track; angle domain is not extended with nice ticks",
    "radiusAxis": "source adaptive five ticks; actual fixed data max305 produces0/80/160/240/320",
    "profileState": "separate source/legacy local animation keys prevent radians/degrees and normalized/DIP state reinterpretation"
  }
