  "materialDifferences": [
    "Docs Demo uses medium labels; Create Basic uses normal labels.",
    "Docs spacing descriptions and exact English/Arabic/Hebrew translations remain separate from plan cards.",
    "Docs plan descriptions include final periods; Create plan descriptions do not.",
    "Docs Subscription Plan has monthly/yearly/lifetime prices and a label-size legend; Create FieldSet has High/Medium/Low battery options and a default-size legend.",
    "Docs Disabled disables only the first option, with Option 2 selected; Create Disabled disables all three options.",
    "Docs Invalid has max-width320 and a14DIP label legend; Create Invalid uses the default16DIP legend and the native bounded preview.",
    "Create Grid has two columns, Small/Medium/Large/X-Large, and Medium selected by default."
  ],
  "adaptation": {
    "input": "Real native RadioBase controls from control.RadioWith belong to one public MyGo RadioGroup; FieldWith/Scope registers labels/descriptions and whole choice-card hit regions. No second Button or radio target is introduced.",
    "state": "Each recipe has an independent application-owned selected string. Choice changes produce local readouts only; there are no subscription/payment/filesystem/network effects.",
    "layout": "Source explicit max-width320/384 caps are retained. Other samples use a384DIP maximum native preview in place of CSS intrinsic width; text can wrap with native font metrics. Grid remains two columns.",
    "navigation": "Native four-arrow navigation is preserved, with logical horizontal mirroring in RTL. Existing public controls supply native pointer/Space and disabled/invalid semantics.",
    "theme": "All content uses current theme tokens and font scope. The global Native/Flyout option changes source configuration selectors; radio content uses the same native base controls in both routes.",
    "assets": "No images, fonts, icon fonts or new runtime dependencies are introduced.",
    "lifecycle": "Persistent state contains only application values and maps; Field scopes, Elements, Contexts and callbacks are current-build only."
  },
