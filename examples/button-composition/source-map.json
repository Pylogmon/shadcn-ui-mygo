  "adaptations": {
    "nativeTargets": "Real MyGo ButtonBase for source Button, including visual link variant; true native Link for both source anchors. No hidden extra ButtonBase exists under links.",
    "samePageHref": "Original href=# is handled by a public Router stored in SDK ui.Local. MyGo resolves it to the same local page; no browser launch, URL-bar fragment update or browser hash scrolling is claimed.",
    "linkComposition": "Native Link target paints current StyleButton hover/pressed/focus appearance; an inert, input-transparent, AX-hidden Row at ZIndex1 paints its label above the target background.",
    "accessibleNames": "Source-provided meaning is preserved; repeated matrix buttons append size to their accessible name, and originally unlabeled icon-only buttons receive descriptive names. Visible text is unchanged.",
    "icons": {
      "ArrowUpIcon": "Material ArrowUpward",
      "ArrowUpRightIcon": "Material ArrowOutward",
